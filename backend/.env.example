# Copy to .env for local development. Never commit the real .env.

ENVIRONMENT=development

# SQLite locally; Postgres (Neon) in production.
DATABASE_URL=sqlite:///./kiku.db
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Firebase project id. Enough to verify ID tokens against Google's public JWKS;
# no service-account key is needed for verification.
FIREBASE_PROJECT_ID=

# Accept "Bearer dev:<uid>" tokens so you can curl the API without a real
# Firebase token. Ignored when ENVIRONMENT=production.
AUTH_DEV_MODE=true

# Leave empty to use deterministic stub glosses (no network, no cost).
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45

# Guardrails
MAX_LINES_PER_LESSON=120
MAX_SUBTITLE_BYTES=512000
DAILY_LESSON_LIMIT=30
